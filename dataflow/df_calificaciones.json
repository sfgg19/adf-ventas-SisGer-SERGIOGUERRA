{
	"name": "df_calificaciones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "calificaciones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "calificaciones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as string,",
				"          puntuacion as string,",
				"          comentario as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(calificacion_id = trim(calificacion_id),",
				"          pedido_id = trim(pedido_id),",
				"          cliente_id = trim(cliente_id),",
				"          comentario = trim(comentario)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(calificacion_id) && calificacion_id != '' && !isNull(pedido_id) && pedido_id != '' && !isNull(cliente_id) && cliente_id != '' && !isNull(puntuacion) && toInteger(puntuacion) >= 1 && toInteger(puntuacion) <= 5,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(calificacion_id),",
				"     pedido_id = first(pedido_id),",
				"          cliente_id = first(cliente_id),",
				"          fecha_calificacion = first(fecha_calificacion),",
				"          puntuacion = first(puntuacion),",
				"          comentario = first(comentario)) ~> aggregate1",
				"aggregate1 derive(fecha_calificacion = toDate(fecha_calificacion, 'yyyy-MM-dd'),",
				"          puntuacion = toInteger(puntuacion)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as date,",
				"          puntuacion as integer,",
				"          comentario as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          calificacion_id,",
				"          pedido_id,",
				"          cliente_id,",
				"          fecha_calificacion,",
				"          puntuacion,",
				"          comentario",
				"     )) ~> sink1"
			]
		}
	}
}
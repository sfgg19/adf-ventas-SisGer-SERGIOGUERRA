{
	"name": "df_detalle-pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "detalles_pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(detalle_id = trim(detalle_id),",
				"          pedido_id = trim(pedido_id),",
				"          producto_id = trim(producto_id),",
				"          precio_unitario = replace(trim(precio_unitario), ',', '.')) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(detalle_id) && detalle_id != '' && !isNull(pedido_id) && pedido_id != '' && !isNull(producto_id) && producto_id != '' && toInteger(cantidad) > 0,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(detalle_id),",
				"     pedido_id = first(pedido_id),",
				"          producto_id = first(producto_id),",
				"          cantidad = first(cantidad),",
				"          precio_unitario = first(precio_unitario),",
				"          descuento_linea = first(descuento_linea),",
				"          total_linea = first(total_linea)) ~> aggregate1",
				"aggregate1 derive(cantidad = toInteger(cantidad),",
				"          precio_unitario = toDecimal(precio_unitario, 12, 2),",
				"          descuento_linea = toDecimal(descuento_linea, 12, 2),",
				"          total_linea = toDecimal(total_linea, 12, 2)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as integer,",
				"          precio_unitario as decimal(12,2),",
				"          descuento_linea as decimal(12,2),",
				"          total_linea as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          detalle_id,",
				"          pedido_id,",
				"          producto_id,",
				"          cantidad,",
				"          precio_unitario,",
				"          descuento_linea,",
				"          total_linea",
				"     )) ~> sink1"
			]
		}
	}
}
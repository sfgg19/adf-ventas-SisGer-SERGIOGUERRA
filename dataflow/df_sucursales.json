{
	"name": "df_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sucursales_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(sucursal_id = trim(sucursal_id),",
				"          restaurante_id = trim(restaurante_id),",
				"          nombre_sucursal = trim(nombre_sucursal),",
				"          ciudad = trim(initCap(ciudad)),",
				"          zona = trim(initCap(zona)),",
				"          direccion = trim(direccion),",
				"          capacidad_mesas = trim(capacidad_mesas),",
				"          tiene_delivery = trim(initCap(tiene_delivery))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(sucursal_id) && sucursal_id != '' && !isNull(nombre_sucursal) && nombre_sucursal != '' && isInteger(capacidad_mesas) && toInteger(capacidad_mesas) >= 0 && restaurante_id != 'RES999',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(sucursal_id),",
				"     restaurante_id = first(restaurante_id),",
				"          nombre_sucursal = first(nombre_sucursal),",
				"          ciudad = first(ciudad),",
				"          zona = first(zona),",
				"          direccion = first(direccion),",
				"          capacidad_mesas = first(capacidad_mesas),",
				"          tiene_delivery = first(tiene_delivery)) ~> aggregate1",
				"aggregate1 derive(capacidad_mesas = toInteger(capacidad_mesas)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as integer,",
				"          tiene_delivery as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sucursal_id,",
				"          restaurante_id,",
				"          nombre_sucursal,",
				"          ciudad,",
				"          zona,",
				"          direccion,",
				"          capacidad_mesas,",
				"          tiene_delivery",
				"     )) ~> sink1"
			]
		}
	}
}
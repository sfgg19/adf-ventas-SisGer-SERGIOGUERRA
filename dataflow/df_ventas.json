{
	"name": "df_ventas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ventas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ventas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          venta_id as string,",
				"          fecha_venta as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          medio_pago as string,",
				"          promocion_id as string,",
				"          estado_venta as string,",
				"          total_venta as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(canal = lower(trim(canal)),",
				"          fecha_venta = trim(fecha_venta),",
				"          promocion_id = iif(isNull(promocion_id),'Sin promocion',trim(promocion_id))) ~> derivedColumn1",
				"derivedColumn1 derive(fecha_venta = iif(instr(fecha_venta, '/') > 0, toDate(fecha_venta, 'dd/MM/yyyy'), toDate(fecha_venta, 'yyyy-MM-dd')),",
				"          total_venta = toDecimal(total_venta)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          venta_id as string,",
				"          fecha_venta as date,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          medio_pago as string,",
				"          promocion_id as string,",
				"          estado_venta as string,",
				"          total_venta as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          venta_id,",
				"          fecha_venta,",
				"          cliente_id,",
				"          sucursal_id,",
				"          canal,",
				"          medio_pago,",
				"          promocion_id,",
				"          estado_venta,",
				"          total_venta",
				"     )) ~> sink1"
			]
		}
	}
}
{
	"name": "df_clientes",
	"properties": {
		"description": "",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          ciudad as string,",
				"          segmento as string,",
				"          fecha_registro as string,",
				"          edad as string,",
				"          nivel_fidelidad as string,",
				"          email as string,",
				"          telefono as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(nombre = initCap(lower(trim(nombre))),",
				"          ciudad = initCap(lower(trim(ciudad)))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(cliente_id) && !isNull(nombre) && !isNull(ciudad) && !isNull(email) && email != '',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(cliente_id = first(cliente_id),",
				"          nombre = first(nombre),",
				"          ciudad = first(ciudad),",
				"          segmento = first(segmento),",
				"          fecha_registro = first(fecha_registro),",
				"          edad = first(edad),",
				"          nivel_fidelidad = first(nivel_fidelidad),",
				"          email = first(email),",
				"          telefono = first(telefono)) ~> aggregate1"
			]
		}
	}
}
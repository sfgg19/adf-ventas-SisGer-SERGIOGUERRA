{
	"name": "df_entregas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "entregas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "entregas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as string,",
				"          hora_entrega as string,",
				"          tiempo_entrega_min as string,",
				"          distancia_km as string,",
				"          estado_entrega as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(entrega_id = trim(entrega_id),",
				"          pedido_id = trim(pedido_id),",
				"          repartidor_id = trim(repartidor_id),",
				"          estado_entrega = trim(initCap(estado_entrega))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(entrega_id) && entrega_id != '' && !isNull(pedido_id) && pedido_id != '' && !isNull(repartidor_id) && repartidor_id != '' && (isNull(tiempo_entrega_min) || toDecimal(tiempo_entrega_min) >= 0),",
				"     disjoint: false) ~> split1@(validados, rechazados)",
				"split1@validados aggregate(groupBy(entrega_id),",
				"     pedido_id = first(pedido_id),",
				"          repartidor_id = first(repartidor_id),",
				"          hora_salida = first(hora_salida),",
				"          hora_entrega = first(hora_entrega),",
				"          tiempo_entrega_min = first(tiempo_entrega_min),",
				"          distancia_km = first(distancia_km),",
				"          estado_entrega = first(estado_entrega)) ~> aggregate1",
				"aggregate1 derive(hora_salida = toTimestamp(hora_salida, 'yyyy-MM-dd HH:mm:ss'),",
				"          hora_entrega = toTimestamp(hora_entrega, 'yyyy-MM-dd HH:mm:ss'),",
				"          tiempo_entrega_min = toDecimal(tiempo_entrega_min, 8, 2),",
				"          distancia_km = toDecimal(distancia_km, 8, 2)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          entrega_id as string,",
				"          pedido_id as string,",
				"          repartidor_id as string,",
				"          hora_salida as timestamp,",
				"          hora_entrega as timestamp,",
				"          tiempo_entrega_min as decimal(8,2),",
				"          distancia_km as decimal(8,2),",
				"          estado_entrega as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          entrega_id,",
				"          pedido_id,",
				"          repartidor_id,",
				"          hora_salida,",
				"          hora_entrega,",
				"          tiempo_entrega_min,",
				"          distancia_km,",
				"          estado_entrega",
				"     )) ~> sink1"
			]
		}
	}
}
{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurantes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(restaurante_id = trim(restaurante_id),",
				"          nombre_restaurante = trim(nombre_restaurante),",
				"          tipo_cocina = trim(initCap(tipo_cocina)),",
				"          activo = trim(initCap(activo))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(restaurante_id) && restaurante_id != '' && !isNull(nombre_restaurante) && nombre_restaurante != '' && (isNull(calificacion_promedio) || (toDecimal(calificacion_promedio) >= 0 && toDecimal(calificacion_promedio) <= 5)),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos aggregate(groupBy(restaurante_id),",
				"     nombre_restaurante = first(nombre_restaurante),",
				"          tipo_cocina = first(tipo_cocina),",
				"          calificacion_promedio = first(calificacion_promedio),",
				"          activo = first(activo)) ~> aggregate1",
				"aggregate1 derive(calificacion_promedio = toDecimal(calificacion_promedio, 3, 1)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as decimal(3,1),",
				"          activo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre_restaurante,",
				"          tipo_cocina,",
				"          calificacion_promedio,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}
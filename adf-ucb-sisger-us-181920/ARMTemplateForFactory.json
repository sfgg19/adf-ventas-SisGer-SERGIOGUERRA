{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-sisger-us-181920"
		},
		"sa omnicanal_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"sa omnicanal\""
		},
		"sql omnicanal_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql omnicanal\""
		},
		"sa omnicanal_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbsisger181920.dfs.core.windows.net/"
		},
		"sql omnicanal_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-sisger-181920.database.windows.net"
		},
		"sql omnicanal_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-ventas"
		},
		"sql omnicanal_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sergioguerra"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/sa omnicanal')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('sa omnicanal_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('sa omnicanal_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sql omnicanal')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "ewrewr12",
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('sql omnicanal_properties_typeProperties_server')]",
					"database": "[parameters('sql omnicanal_properties_typeProperties_database')]",
					"encrypt": "optional",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('sql omnicanal_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sql omnicanal_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}
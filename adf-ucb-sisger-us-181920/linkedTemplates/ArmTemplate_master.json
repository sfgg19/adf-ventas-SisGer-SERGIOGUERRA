{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-sisger-us-181920"
		},
		"sa omnicanal_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"sa omnicanal\""
		},
		"sql omnicanal_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql omnicanal\""
		},
		"sa omnicanal_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saucbsisger181920.dfs.core.windows.net/"
		},
		"sql omnicanal_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-sisger-181920.database.windows.net"
		},
		"sql omnicanal_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-ventas"
		},
		"sql omnicanal_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sergioguerra"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ucb-sisger-us-181920_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"sa omnicanal_accountKey": {
						"value": "[parameters('sa omnicanal_accountKey')]"
					},
					"sql omnicanal_password": {
						"value": "[parameters('sql omnicanal_password')]"
					},
					"sa omnicanal_properties_typeProperties_url": {
						"value": "[parameters('sa omnicanal_properties_typeProperties_url')]"
					},
					"sql omnicanal_properties_typeProperties_server": {
						"value": "[parameters('sql omnicanal_properties_typeProperties_server')]"
					},
					"sql omnicanal_properties_typeProperties_database": {
						"value": "[parameters('sql omnicanal_properties_typeProperties_database')]"
					},
					"sql omnicanal_properties_typeProperties_userName": {
						"value": "[parameters('sql omnicanal_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-ucb-sisger-us-181920_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-ucb-sisger-us-181920_ArmTemplate_0')]"
			]
		}
	]
}